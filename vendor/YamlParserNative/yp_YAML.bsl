////////////////////////////////////////////////////////////////////////////////
// Обёртка внешней компоненты «Парсер YAML» (Native API, реализация на Rust).
//
// Компонента принимает текст YAML и возвращает JSON. Это не упрощение, а
// требование платформы: Native API не позволяет вернуть структуру или массив —
// документация прямо запрещает значения VTYPE_ARRAY и типы
// VTYPE_VARIANT / VTYPE_INTERFACE. Поэтому модуль читает полученный JSON
// средствами платформы (ЧтениеJSON) и отдаёт вызывающему коду обычные значения
// 1С: Соответствие, Структуру и Массив.
//
// Имя объекта компоненты, как его видит платформа, — «AddIn.YamlParser.YamlParser».
// Второй «YamlParser» не опечатка. Функция GetClassNames отвечает «1», но платформа
// использует «1» только как внутренний идентификатор класса для GetClassObject, а
// видимое имя типа — это имя, которое компонента регистрирует за собой
// (RegisterExtensionAs). Измерено на 8.3.24.1667: «AddIn.YamlParser.1» не существует,
// а «AddIn.YamlParser.YamlParser» существует.
//
// Безопасный режим. Платформа запрещает загрузку и подключение внешних компонент,
// пока установлен безопасный режим. Отключить безопасный режим из процедуры, которая
// его не устанавливала, тоже нельзя. Подключение выполняется при каждом вызове
// (см. ниже), поэтому вызывать функции модуля из кода, работающего в безопасном
// режиме, нельзя; функция ПодключитьКомпоненту говорит об этом в тексте исключения.
//
// Состояние сеанса модуль не хранит. Общий модуль расширения конфигурации не может
// объявлять переменные модуля — платформа отвечает «Данный модуль может содержать
// только определения процедур и функций». Поэтому кэша подключённой компоненты нет,
// и каждая операция подключает её заново.
//
// Параметры разбора (второй аргумент функций) передаются обычной Структурой 1С и
// сериализуются в JSON. Доступные ключи и их значения описаны в
// docs/plan/yaml-json-mapping.md; неизвестный ключ считается ошибкой, а не
// молча игнорируется.
//
//	duplicateKeys     "lastWins" (по умолчанию) | "error"
//	multiDocument     "auto" (по умолчанию) | "first" | "error"
//	complexKeys       "error" (по умолчанию) | "stringify"
//	nonFiniteNumbers  "string" (по умолчанию) | "null" | "error"
//	largeIntegers     "string" (по умолчанию) | "number"
//	maxDepth          число, по умолчанию 128; 0 — без ограничения
//	pretty            Булево, по умолчанию Ложь
////////////////////////////////////////////////////////////////////////////////

// Полное имя объекта компоненты после подключения.
//
// Возвращает:
//	Строка — имя для конструктора Новый(), например «AddIn.YamlParser.YamlParser».
//
Функция ПолноеИмяОбъектаКомпоненты() Экспорт
	
	Возврат "AddIn." + ИмяПодключенияКомпоненты() + "." + ИмяКлассаКомпоненты();
	
КонецФункции

// Подключает компоненту к текущему сеансу и возвращает её экземпляр.
//
// Подключение выполняется при каждом вызове: модуль не хранит состояние
// (см. заголовок), поэтому помнить уже подключённую компоненту негде.
//
// Параметры:
//	Местоположение - Неопределено, Строка, Макет - откуда загружать компоненту.
//		Неопределено (по умолчанию) — макет расширения «ОбщийМакет.yp_YamlParserNative»,
//		в котором архив с компонентой хранится как двоичные данные.
//		Строка — полное имя макета, путь к файлу или URL.
//
// Возвращает:
//	ВнешняяКомпонента — подключённая компонента.
//
Функция ПодключитьКомпоненту(Местоположение = Неопределено) Экспорт
	
	Если БезопасныйРежим() Тогда
		ВызватьИсключение
		"Компоненту «Парсер YAML» нельзя подключить в безопасном режиме.
		|Платформа запрещает загрузку и подключение внешних компонент, пока безопасный
		|режим установлен, а отключить его из этой процедуры нельзя.
		|Подключите компоненту до входа в безопасный режим — например, в начале работы
		|сеанса или в коде, который готовит данные, — и передайте её тому коду, который
		|выполняется в безопасном режиме.";
	КонецЕсли;
	
	Если Местоположение = Неопределено Тогда
		Местоположение = "ОбщийМакет." + ИмяМакетаКомпоненты();
	КонецЕсли;
	
	ПодключитьВнешнююКомпоненту(Местоположение, ИмяПодключенияКомпоненты(), ТипВнешнейКомпоненты.Native);
	
	Возврат Новый(ПолноеИмяОбъектаКомпоненты());
	
КонецФункции

// Версия компоненты — для журнала регистрации и обращений в поддержку.
//
// Возвращает:
//	Строка — версия в виде «0.1.0».
//
Функция ВерсияКомпоненты() Экспорт
	
	Возврат ПодключитьКомпоненту().Версия();
	
КонецФункции

// Разбирает текст YAML и возвращает документ значениями 1С.
//
// Параметры:
//	Текст - Строка - документ YAML.
//	Настройки - Неопределено, Структура - параметры разбора, см. заголовок модуля.
//	ЧитатьВСтруктуру - Булево - Ложь (по умолчанию) возвращает объекты YAML
//		Соответствием, Истина — Структурой.
//		Соответствие принимает любой ключ и поэтому выбрано значением по умолчанию:
//		в YAML ключом может быть строка вроде «my-key» или «1», а Структура такие
//		ключи не принимает и вместо разбора вызовет исключение.
//		Структура удобнее в обращении — Структура.Ключ вместо Соответствие["Ключ"].
//
// Возвращает:
//	Соответствие, Структура, Массив, Строка, Число, Булево, Неопределено - документ.
//		Null из JSON читается платформой как Неопределено.
//
// Стоимость: при ЧитатьВСтруктуру = Ложь разбор текста выполняется один раз.
// Значение приходит уже готовым, потому что ответ компоненты читается целиком.
// При Истина значение сериализуется и читается заново — второго прохода требует
// именно выбор Структуры, и он делается только у того, кто его попросил.
//
Функция РазобратьYAML(Текст, Настройки = Неопределено, ЧитатьВСтруктуру = Ложь) Экспорт
	
	Ответ = РазобратьYAMLСОтветом(Текст, Настройки);
	
	Если НЕ ЧитатьВСтруктуру Тогда
		Возврат Ответ["result"];
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ЗаписатьJSONЗначение(Ответ["result"]));
	
	Попытка
		// Ложь: вызывающий попросил именно Структуру, и здесь её ключи уже проверены
		// первым чтением ответа — иначе разбор ответа упал бы раньше.
		Значение = ПрочитатьJSON(Чтение, Ложь);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	
	Чтение.Закрыть();
	
	Возврат Значение;
	
КонецФункции

// Разбирает текст YAML и возвращает полный ответ компоненты.
//
// Нужна, когда важны подробности: вид ошибки, строка и колонка, а также когда
// результат требуется в виде JSON. Ответ компоненты — обычный JSON, поэтому его
// можно передать дальше как есть; сам документ лежит в свойстве «result».
//
// Параметры:
//	Текст - Строка - документ YAML.
//	Настройки - Неопределено, Структура - параметры разбора, см. заголовок модуля.
//
// Возвращает:
//	Соответствие - «ok» (Булево), «result» (документ) или «error» (Соответствие
//		с ключами «kind», «message», «line», «column»).
//
// Вызывает исключение, если документ разобрать не удалось.
//
Функция РазобратьYAMLСОтветом(Текст, Настройки = Неопределено) Экспорт
	
	Ответ = ПрочитатьОтветКомпоненты(Текст, Настройки);
	
	Если НЕ Ответ["ok"] Тогда
		ВызватьИсключение ТекстОшибкиРазбора(Ответ["error"]);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Служебные процедуры и функции

// Имя, под которым компонента подключается к сеансу.
Функция ИмяПодключенияКомпоненты()
	
	Возврат "YamlParser";
	
КонецФункции

// Имя, под которым компонента регистрирует себя внутри библиотеки (RegisterExtensionAs).
// Платформа составляет из него имя типа объекта. См. заголовок модуля.
Функция ИмяКлассаКомпоненты()
	
	Возврат "YamlParser";
	
КонецФункции

// Имя макета расширения, в котором лежит архив с компонентой.
Функция ИмяМакетаКомпоненты()
	
	Возврат "yp_YamlParserNative";
	
КонецФункции

// Вызывает компоненту и читает её ответ.
//
// Возвращает:
//	Соответствие - разобранный ответ компоненты.
//
Функция ПрочитатьОтветКомпоненты(Текст, Настройки)
	
	ОтветJSON = ПодключитьКомпоненту().РазобратьYAML(Текст, НастройкиВJSON(Настройки));
	
	Если ПустаяСтрока(ОтветJSON) Тогда
		ВызватьИсключение "Компонента «Парсер YAML» вернула пустой ответ.";
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ОтветJSON);
	
	Попытка
		// Истина: ответ читается в Соответствие, потому что ключи документа YAML
		// произвольны и Структура их не примет. Измерено: при Ложь платформа читает
		// объекты JSON в Структуру и падает на ключе «my-key».
		Ответ = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	
	Чтение.Закрыть();
	
	Если ТипЗнч(Ответ) <> Тип("Соответствие") Или Ответ["ok"] = Неопределено Тогда
		ВызватьИсключение "Компонента «Парсер YAML» вернула ответ неизвестного вида: " + ОтветJSON;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

// Собирает текст исключения из описания ошибки, пришедшего от компоненты.
Функция ТекстОшибкиРазбора(Ошибка)
	
	Позиция = "";
	
	Если Ошибка["line"] <> Неопределено Тогда
		Позиция = СтрШаблон(" (строка %1, колонка %2)", Ошибка["line"], Ошибка["column"]);
	КонецЕсли;
	
	Возврат СтрШаблон("Не удалось разобрать YAML%1: %2", Позиция, Ошибка["message"]);
	
КонецФункции

// Сериализует настройки разбора. Пустая строка означает «значения по умолчанию».
Функция НастройкиВJSON(Настройки)
	
	Если Настройки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ЗаписатьJSONЗначение(Настройки);
	
КонецФункции

// Записывает значение 1С в строку JSON.
Функция ЗаписатьJSONЗначение(Значение)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	
	ЗаписатьJSON(Запись, Значение);
	
	Возврат Запись.Закрыть();
	
КонецФункции