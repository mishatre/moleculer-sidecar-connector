// Standalone tests for the internal service resolver.

#Region ИсполняемыеСценарии

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТест("ВнутреннийСервисКомпилируется_и_его_обработчик_находится");

КонецПроцедуры

#EndRegion

// T032. В автономном варианте сервис mol_Internal живёт внутри слиянного модуля, поэтому проверяем
// не только то, что схема собирается, но и то, что обработчик действия находится по имени — именно
// этого не хватало, когда запрос к $internal.* отвечал 503 `Handler is not provided`.
//
// Проверка появилась из диагностики: CompileServiceSchema принимает имя модуля строкой, а патч
// профиля передавал объект метаданных, поэтому компиляция отвечала Неопределено, а исключение
// проглатывалось в Except. Тест ловит возврат к этому поведению.
Процедура ВнутреннийСервисКомпилируется_и_его_обработчик_находится() Экспорт

	Схема = Moleculer.CompileServiceSchema("Moleculer");

	ЮТест.ОжидаетЧто(Схема, "схема внутреннего сервиса собирается в автономном варианте")
		.НеРавно(Неопределено);

	ЮТест.ОжидаетЧто(Схема.Name, "имя, которое объявляет конструктор внутреннего сервиса")
		.Равно("$internal");

	Обработчик = Moleculer.Delete_FindInternalHandler("$internal.ping");

	ЮТест.ОжидаетЧто(Обработчик, "обработчик $internal.ping находится по имени")
		.НеРавно(Неопределено);

КонецПроцедуры
