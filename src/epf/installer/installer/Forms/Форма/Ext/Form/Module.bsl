
#Region Variables

Var ExtensionData;

Var PlatformData;
Var Compatibility;

#EndRegion

#Region FormEventHandlers

&AtServer
Procedure OnCreateAtServer(Cancel, StandardProcessing)
	
	УстановкаВозможна = IsExtensionInstallationPossible(ОписаниеОшибки);
	
	EnsureExtensionDataLoaded();
	ManageForm(ThisForm);
	
EndProcedure

&AtClient
Procedure OnOpen(Cancel)
	
	If УстановкаВозможна Then
		If IsSyncMethodUsageRestricted() Then
			Items.СтраницыГлавнаяПанель.CurrentPage = Items.СтраницаЗапускНовогоСеанса;
			ПодключитьОбработчикОжидания("StartThickClientSession", 2000);
		EndIf;
	EndIf;
	
EndProcedure

#EndRegion

#Region FormHeaderItemsEventHandlers

&AtClient
Procedure CancelSessionLaunch(Item, FormattedStringURL, StandardProcessing)
	
	ОтключитьОбработчикОжидания("StartThickClientSession");
	Items.ДекорацияЗапускНовогоСеансаОтменен.Visible = True;
	Items.ДекорацияЗапускНовогоСеанса       .Visible = False;
	
EndProcedure

&AtClient
Procedure RestartSessionLaunch(Item, FormattedStringURL, StandardProcessing)
	
	Items.ДекорацияЗапускНовогоСеансаОтменен.Visible = False;
	Items.ДекорацияЗапускНовогоСеанса       .Visible = True;
	ПодключитьОбработчикОжидания("StartThickClientSession", 100);
	
EndProcedure

#EndRegion

#Region FormCommandsEventHandlers

&AtClient
Procedure InstallExtension(Command)
	
	BinaryData = Undefined;
	If ЗначениеЗаполнено(ФайлРасширения) Then
		BinaryData = Новый ДвоичныеДанные(ФайлРасширения);
	Else
		BinaryData = DownloadExtensionFileFromServer();
	EndIf;
	
	InstallExtensionAtServer(BinaryData);
	
EndProcedure

&AtClient
Procedure DeleteExtension(Command)
	
	DeleteExtensionAtServer();
	
EndProcedure

#EndRegion

#Region Private

#Region FormState

&AtClientAtServerNoContext
Procedure ManageForm(Form)
	
	Items           = Form.Items;
	InstallerParams = Form.ПараметрыУстановщика;
	
	Form.AutoTitle = False;
	Form.Title     = InstallerParams.Представление;
	
	If Not Form.УстановкаВозможна Then
		Items.СтраницыГлавнаяПанель.CurrentPage           = Items.СтраницаУстановкаНеПоддерживается;
		Items[Form.ОписаниеОшибки.ИмяГруппыФормы].Visible = True;
	EndIf;
	
	If ExtensionData <> Undefined Then
		If ExtensionData.Active Then
			Items.ГруппаСостояние.Visible = True;
			Form.СостояниеРасширения       = ActiveExtensionStateCaption();
		ElsIf ExtensionData.Installed Then
			Items.ГруппаСостояние.Visible = True;
			Form.СостояниеРасширения       = InactiveExtensionStateCaption();
		EndIf;
		
		If ExtensionData.Active Or ExtensionData.Installed Then
			Form.ВерсияРасширения = ExtensionVersionCaption(ExtensionData.Version);
		EndIf;
	EndIf;
	
	Form.ВерсияУстановщика = InstallerParams.Версия;
	
EndProcedure

&AtClientAtServerNoContext
Function ExtensionVersionCaption(CurrentVersion, NewVersion = Undefined)
	
	CaptionParts = Новый Массив();
	CaptionParts.Добавить("Текущая версия:");
	CaptionParts.Добавить(" ");
	CaptionParts.Добавить(
		Новый ФорматированнаяСтрока(
			CurrentVersion,
			Новый Шрифт("",12),
			?(NewVersion = Undefined, ЦветаСтиля.ЦветАкцента, ЦветаСтиля.ЦветОсобогоТекста)
		)
	);
	If NewVersion <> Undefined Then
		CaptionParts.Добавить(" ");
		CaptionParts.Добавить(БиблиотекаКартинок.СтрелкаВправо);
		CaptionParts.Добавить(" ");
		CaptionParts.Добавить(
			Новый ФорматированнаяСтрока(
				CurrentVersion,
				Новый Шрифт("",12),
				ЦветаСтиля.ЦветАкцента
			)
		);
		CaptionParts.Добавить(" ");
		CaptionParts.Добавить(
			Новый ФорматированнаяСтрока(
				"обновить",
				Новый Шрифт("",12),
				ЦветаСтиля.ГиперссылкаЦвет,
				,
				"обновить"
			)
		);
	EndIf;

	Return Новый ФорматированнаяСтрока(CaptionParts);
	
EndFunction

&AtClientAtServerNoContext
Function ActiveExtensionStateCaption()

	Return Новый ФорматированнаяСтрока(
		"Расширение установлено и активно", Новый Шрифт("",12), ЦветаСтиля.ЦветАкцента);

EndFunction

&AtClientAtServerNoContext
Function InactiveExtensionStateCaption()

	CaptionParts = Новый Массив();
	CaptionParts.Добавить(Новый ФорматированнаяСтрока(
		"Расширение установлено ", Новый Шрифт("",12), ЦветаСтиля.ЦветАкцента));
	CaptionParts.Добавить(Новый ФорматированнаяСтрока(
		"(не активно)",, ЦветаСтиля.ЦветОсобогоТекста));

	Return Новый ФорматированнаяСтрока(CaptionParts);

EndFunction

#EndRegion

Функция УстановкаРасширенияВозможна(ОписаниеОшибки)
	
	ОписаниеОшибки = Новый Структура();     
	ОписаниеОшибки.Вставить("ТипОшибки");
	ОписаниеОшибки.Вставить("ИмяГруппыФормы");
	
	#Если ВебКлиент Тогда     
		ОписаниеОшибки.ТипОшибки      = "УстановкаВВебКлиенте"; 
		ОписаниеОшибки.ИмяГруппыФормы = "ГруппаУстановкаВВебКлиенте";
		Возврат Ложь;
	#КонецЕсли 
	
	Если ВерсияПлатформыНиже(Совместимость.МинимальнаяВерсияПлатформы) Тогда
		ОписаниеОшибки.ТипОшибки      = "МинимальнаяВерсияПлатформы";
		ОписаниеОшибки.ИмяГруппыФормы = "ГруппаМинимальнаяВерсияПлатформы";
		Возврат Ложь;
		Сообщить("Необходима версия платформы 8.3.10 или выше");
	КонецЕсли;     
	
	Если ВерсияРежимаСовместимостиНиже(Совместимость.МинВерсияРежимаСовместимости) Тогда
		ОписаниеОшибки.ТипОшибки      = "МинВерсияРежимаСовместимости";
		ОписаниеОшибки.ИмяГруппыФормы = "ГруппаМинВерсияРежимаСовместимости";
		Возврат Ложь;
		Сообщить("Необходим режим совместимости конфигурации 8.3.9 или выше");
	КонецЕсли;   
	
	ЗагрузитьДанныеУстановленногоРасширения();
	
	Если МодульВстроенВКонфигурацию() Тогда
		ОписаниеОшибки.ТипОшибки      = "МодульВстроенВКонфигурацию";
		ОписаниеОшибки.ИмяГруппыФормы = "ГруппаМодульВстроенВКонфигурацию";
		Возврат Ложь;
		Сообщить("В конфигурации встроена подсистема ""Инструменты разработчика"". Установка расширения невозможна.");
	КонецЕсли;   
	
	Возврат Истина
	
КонецФункции

