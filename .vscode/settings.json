{
	"gherkin-autocomplete.featureLibraries": ["features"],
	"gherkin-autocomplete.srcBslPath": ["features"],
	"git.ignoreLimitWarning": true,
	"files.associations": {
		"*.bsl": "bsl",
		"*.os": "bsl"
	},

	"files.exclude": {
		"**/.git": true,
		"**/oscript_modules": true
	},

	"search.exclude": {
		"**/oscript_modules": true,
		"**/build": true
	},

	"terminal.integrated.cwd": "${workspaceFolder}",

}
